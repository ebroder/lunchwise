{
  "name": "lunchwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "wrangler dev & vite dev",
    "build": "vite build && npm run css && node scripts/generate-spa-html.ts",
    "deploy": "npm run build && wrangler deploy",
    "css": "tailwindcss -i src/styles.css -o dist/client/styles.css --minify",
    "lint": "oxlint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/cloudflare": "^11.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "preact": "^11.0.0",
    "stemmer": "^2.0.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/cli": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@sentry/cloudflare": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    },
    "wrangler": {
      "@cloudflare/workers-types": "$@cloudflare/workers-types"
    }
  }
}
